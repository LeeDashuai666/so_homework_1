+#define BOLT_PASSES_CMOVBRANCHIFY_H
+
+#include "bolt/Passes/BinaryPasses.h"
+
+namespace llvm {
+namespace bolt {
+
+/// Expose CMOV predicates for instrumentation, or convert independently
+/// validated loop sites using a binary- and host-bound predicate profile.
+class CMOVBranchify : public BinaryFunctionPass {
+public:
+  CMOVBranchify() : BinaryFunctionPass(false) {}
+  const char *getName() const override { return "profile-informed CMOV branchification"; }
+  Error runOnFunctions(BinaryContext &BC) override;
+};
+
+} // namespace bolt
