+    "cmov-runtime-kernel", cl::desc("batch ABI v1 kernel symbol"),
+    cl::init("cmov_kernel_v1"), cl::cat(BoltOptCategory));
+static cl::opt<std::string> CMOVRuntimeEntry(
+    "cmov-runtime-entry", cl::desc("batch ABI v1 forwarding entry symbol"),
+    cl::init("cmov_batch_v1"), cl::cat(BoltOptCategory));
+static cl::opt<std::string> CMOVRuntimePlain(
+    "cmov-runtime-plain", cl::desc("batch ABI v1 original driver symbol"),
+    cl::init("cmov_plain_v1"), cl::cat(BoltOptCategory));
