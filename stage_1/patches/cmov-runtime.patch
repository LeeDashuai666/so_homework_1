+namespace {
+class CMOVRuntimeLibrary final : public RuntimeLibrary {
+  BinaryFunction *Thunk;
+public:
+  explicit CMOVRuntimeLibrary(BinaryFunction *Thunk) : Thunk(Thunk) {}
+  void addRuntimeLibSections(std::vector<std::string> &) const override {}
+  void adjustCommandLineOptions(const BinaryContext &) const override {}
+  void emitBinary(BinaryContext &, MCStreamer &) override {}
+  void link(BinaryContext &BC, StringRef ToolPath, BOLTLinker &Linker,
+            BOLTLinker::SectionsMapper Mapper) override {
+    loadLibrary(getLibPath(ToolPath, opts::CMOVRuntimeLib), Linker, Mapper);
+    auto Target = Linker.lookupSymbolInfo("__bolt_cmov_adapt_v1");
+    if (!Target) {
+      BC.errs() << "BOLT-ERROR: missing CMOV admission runtime entry\n";
+      exit(1);
+    }
+    // JITLink resolves unknown externals to zero when linking the input object
+    // before runtime objects. Complete this one dedicated rel32 relocation now
+    // that both addresses exist. The stub has no padding/stack effects; never
+    // infer an offset in arbitrary application code.
+    auto Section = Thunk->getCodeSection();
+    auto *Image = Section ? reinterpret_cast<uint8_t *>(Section->getAllocAddress() +
+        Thunk->getOutputAddress() - Section->getOutputAddress()) : nullptr;
+    const int64_t Disp = int64_t(Target->Address) -
+                         int64_t(Thunk->getOutputAddress() + 5);
+    if (!Image || Thunk->getOutputSize() != 5 || Image[0] != 0xe9 ||
+        !isInt<32>(Disp)) {
+      BC.errs() << "BOLT-ERROR: CMOV runtime thunk requires a rel32 jump\n";
+      exit(1);
+    }
+    support::endian::write32le(Image + 1, uint32_t(Disp));
+    BC.outs() << "BOLT-INFO: linked CMOV admission runtime (no init/fini hooks)\n";
+  }
+};
+
+struct Predicate {
+  uint64_t True = 0;
+  uint64_t False = 0;
+  unsigned Size = 0;
+  bool Validated = false;
+  double ValidationLower = 0;
+};
+
+struct Site {
+  BinaryBasicBlock *BB;
+  unsigned Index;
+  unsigned Count;
+  unsigned CC;
+  uint32_t Offset;
+  uint32_t EndOffset;
+  unsigned LoopDepth;
+  unsigned OldBytes;
+  unsigned NewBytes;
+};
+
+std::string key(StringRef Function, uint32_t Offset) {
+  return (Function + ":" + Twine(Offset)).str();
+}
+
+Error invalid(const Twine &Message) {
+  return createFatalBOLTError(Twine("CMOV branchification: ") + Message);
+}
+
+Expected<std::string> inputHash(BinaryContext &BC) {
+  auto Buffer = MemoryBuffer::getFile(BC.getFilename());
+  if (!Buffer)
+    return invalid(Twine("cannot read input: ") + Buffer.getError().message());
+  SHA256 Hash;
+  Hash.update((*Buffer)->getBuffer());
+  return toHex(Hash.final(), /*LowerCase=*/true);
+}
+
+Expected<StringMap<Predicate>> readProfile(StringRef Path, StringRef Hash) {
+  auto Buffer = MemoryBuffer::getFile(Path);
+  if (!Buffer)
+    return invalid(Twine("cannot read profile: ") + Buffer.getError().message());
+  auto Parsed = json::parse((*Buffer)->getBuffer());
+  if (!Parsed)
+    return invalid(Twine("invalid profile JSON: ") + toString(Parsed.takeError()));
+  const json::Object *Root = Parsed->getAsObject();
+  if (!Root || Root->getInteger("schema_version") != 1 ||
+      Root->getString("binary_sha256") != Hash)
+    return invalid("profile version or input SHA256 mismatch");
+  if (Root->getString("host_cpu") != sys::getHostCPUName())
+    return invalid("profile CPU mismatch; recollect and validate on this host");
+  const json::Array *Records = Root->getArray("sites");
+  if (!Records)
+    return invalid("missing sites array");
+  StringMap<Predicate> Result;
+  for (const json::Value &Value : *Records) {
+    const json::Object *Record = Value.getAsObject();
+    if (!Record)
+      return invalid("site must be an object");
+    auto Name = Record->getString("function");
+    auto Offset = Record->getInteger("offset");
+    auto True = Record->getInteger("true_count");
+    auto False = Record->getInteger("false_count");
+    auto Size = Record->getInteger("group_size");
+    if (!Name || !Offset || *Offset < 0 ||
+        uint64_t(*Offset) > std::numeric_limits<uint32_t>::max() ||
+        !True || *True < 0 || !False || *False < 0 || !Size ||
+        *Size < 2 || *Size > 4)
+      return invalid("invalid site identity, group size, or counters");
+    Predicate P{uint64_t(*True), uint64_t(*False), unsigned(*Size),
+                Record->getBoolean("validated").value_or(false),
+                Record->getNumber("validation_speedup_lower").value_or(0)};
+    if (!Result.try_emplace(key(*Name, uint32_t(*Offset)), P).second)
+      return invalid("duplicate site");
+  }
+  return Result;
+}
+
+void branchify(BinaryFunction &BF, const Site &S, const Predicate *P) {
+  BinaryContext &BC = BF.getBinaryContext();
+  auto &MIB = *BC.MIB;
+  BinaryBasicBlock &Head = *S.BB;
+  SmallVector<BinaryBasicBlock *, 16> OldLayout(BF.getLayout().blocks());
+  const auto OldEnd = Head.getEndOffset();
+  const uint64_t OldCount = Head.getExecutionCount();
+  BinaryBasicBlock *Moves = Head.splitAt(Head.begin() + S.Index);
+  BinaryBasicBlock *Tail = Moves->splitAt(Moves->begin() + S.Count);
+  Head.setInputAddressRange(Head.getInputOffset(), S.Offset);
+  Moves->setInputAddressRange(S.Offset, S.EndOffset);
+  Tail->setInputAddressRange(S.EndOffset, OldEnd);
+
+  // splitAt propagates the exact CFI state at both boundaries. No admitted
+  // move changes SP/FP, flags, or memory, including overlapping register copies.
+  for (MCInst &Inst : *Moves) {
+    unsigned CC;
+    const bool Converted = MIB.convertConditionalMoveToMove(Inst, CC);
+    assert(Converted && CC == S.CC && "candidate changed after collection");
+    (void)Converted;
+  }
+
+  uint64_t TrueCount = 0, FalseCount = 0;
+  if (P && OldCount != BinaryBasicBlock::COUNT_NO_PROFILE) {
+    const uint64_t Total = P->True + P->False;
+    TrueCount = (static_cast<__uint128_t>(OldCount) * P->True) / Total;
+    FalseCount = OldCount - TrueCount;
+    Moves->setExecutionCount(TrueCount);
+    Tail->setExecutionCount(OldCount);
+  }
+  Head.removeAllSuccessors();
+  Head.addSuccessor(Tail, FalseCount, 0);
+  Head.addSuccessor(Moves, TrueCount, 0);
+  if (P)
+    Moves->setSuccessorBranchInfo(*Tail, TrueCount, 0);
+  MCInst Branch;
+  MIB.createCondBranch(Branch, Tail->getLabel(),
+                       MIB.getInvertedCondCode(S.CC), BC.Ctx.get());
+  MIB.setOffset(Branch, S.Offset);
+  Head.addInstruction(Branch);
+
+  SmallVector<BinaryBasicBlock *, 16> NewLayout;
+  for (BinaryBasicBlock *BB : OldLayout) {
+    NewLayout.push_back(BB);
+    if (BB == &Head) {
+      NewLayout.push_back(Moves);
+      NewLayout.push_back(Tail);
+    }
+  }
+  BF.getLayout().update(NewLayout);
+}
+
+// Only leaf CFGs with direct internal branches and no address-bearing operands
+// are cloned. Unwind programs, block entry states and every stack effect are
+// copied; this is not the inliner's CFI-dropping path.
+bool canClone(const BinaryFunction &BF) {
+  for (const BinaryBasicBlock &BB : BF) {
+    if (BB.hasLocSyms())
+      return false;
+    for (const MCInst &Inst : BB) {
+      auto &MIB = *BF.getBinaryContext().MIB;
+      if (MIB.isCall(Inst) || MIB.isIndirectBranch(Inst) ||
+          MIB.isTailCall(Inst) || MIB.getInstLabel(Inst))
+        return false;
+      for (unsigned I = 0; I != MCPlus::getNumPrimeOperands(Inst); ++I)
+        if (Inst.getOperand(I).isExpr() && !MIB.isBranch(Inst))
+          return false;
+      if (MIB.isBranch(Inst) &&
+          !BF.getBasicBlockForLabel(MIB.getTargetSymbol(Inst)))
+        return false;
+    }
+  }
+  return true;
+}
+
+BinaryFunction *cloneKernel(BinaryFunction &Source,
+                            DenseMap<const BinaryBasicBlock *, BinaryBasicBlock *> &Map) {
+  BinaryContext &BC = Source.getBinaryContext();
+  BinaryFunction *Clone = BC.createInjectedBinaryFunction("__bolt_cmov_branch_v1");
+  Clone->copyCFIProgramsFrom(Source);
+  Clone->setExecutionCount(Source.getExecutionCount());
+  if (Source.hasValidProfile())
+    Clone->markProfiled(Source.getProfileFlags());
+  for (const BinaryBasicBlock *BB : Source.getLayout().blocks()) {
+    BinaryBasicBlock *New = Clone->addBasicBlock();
+    New->setCFIState(BB->getCFIState());
+    New->setExecutionCount(BB->getExecutionCount());
+    New->setInputAddressRange(BB->getInputOffset(), BB->getEndOffset());
+    Map[BB] = New;
+  }
+  for (const BinaryBasicBlock *BB : Source.getLayout().blocks()) {
+    BinaryBasicBlock *New = Map[BB];
+    for (MCInst Inst : *BB) {
+      if (BC.MIB->isBranch(Inst)) {
+        const BinaryBasicBlock *Target =
+            Source.getBasicBlockForLabel(BC.MIB->getTargetSymbol(Inst));
+        BC.MIB->replaceBranchTarget(Inst, Map[Target]->getLabel(), BC.Ctx.get());
+      }
+      New->addInstruction(Inst);
+    }
+    auto BI = BB->branch_info_begin();
+    for (const BinaryBasicBlock *Succ : BB->successors()) {
+      New->addSuccessor(Map[Succ], BI->Count, BI->MispredictedCount);
+      ++BI;
+    }
+  }
+  return Clone;
+}
+
+MCPlusBuilder::CMOVRuntimeEntryCode zeroWorkEntry(
+    BinaryFunction &Kernel, const MCSymbol *Branch, const MCSymbol *Runtime) {
+  auto &BC = Kernel.getBinaryContext();
+  auto &MIB = *BC.MIB;
+  auto RealInstructions = [&](const BinaryBasicBlock &BB) {
+    SmallVector<MCInst, 8> Instructions;
+    for (const MCInst &I : BB)
+      if (!MIB.isPseudo(I))
+        Instructions.push_back(I);
+    return Instructions;
+  };
+  const BinaryBasicBlock &Entry = Kernel.front();
+  const auto EntryCode = RealInstructions(Entry);
+  if (EntryCode.size() != 2 || Entry.succ_size() != 2 ||
+      !MIB.isConditionalBranch(EntryCode.back()))
+    return {};
+  const BinaryBasicBlock *Zero =
+      Kernel.getBasicBlockForLabel(MIB.getTargetSymbol(EntryCode.back()));
+  if (!Zero)
+    return {};
+  const BinaryBasicBlock *Check = nullptr;
+  for (const BinaryBasicBlock *Succ : Entry.successors())
+    if (Succ != Zero)
+      Check = Succ;
+  if (!Check || Check->succ_size() != 2 || Zero->succ_size() != 0)
+    return {};
+  const auto CheckCode = RealInstructions(*Check);
+  if (CheckCode.empty() || !MIB.isConditionalBranch(CheckCode.back()) ||
+      MIB.getTargetSymbol(CheckCode.back()) != Zero->getLabel())
+    return {};
+  return MIB.createCMOVRuntimeZeroWorkEntry(
+      EntryCode, CheckCode, RealInstructions(*Zero), Kernel.getSymbol(),
+      Branch, Runtime, BC.Ctx.get());
+}
+} // namespace
+
+Error CMOVBranchify::runOnFunctions(BinaryContext &BC) {
+  if (!BC.isX86())
+    return invalid("only x86-64 is supported");
+  if (unsigned(opts::CMOVBranchify) + unsigned(opts::CMOVBranchifyRuntime) + unsigned(opts::CMOVBranchifyCandidate) +
+          unsigned(opts::CMOVBranchifyProbe) > 1)
+    return invalid("optimization and probe modes are mutually exclusive");
+  if (opts::CMOVBranchifyProbe && !opts::Instrument)
+    return invalid("probe mode requires -instrument");
+  if ((opts::CMOVBranchify || opts::CMOVBranchifyRuntime || opts::CMOVBranchifyCandidate) && opts::CMOVBranchifyProfile.empty())
+    return invalid("-cmov-branchify requires -cmov-branchify-profile");
+  if (opts::CMOVBranchifyMinBias < 50 || opts::CMOVBranchifyMinBias > 100 ||
+      !opts::CMOVBranchifyMinCount)
+    return invalid("bias must be 50..100 and minimum count must be positive");
+  auto Hash = inputHash(BC);
+  if (!Hash)
+    return Hash.takeError();
+  StringMap<Predicate> Profile;
+  if (opts::CMOVBranchify || opts::CMOVBranchifyRuntime || opts::CMOVBranchifyCandidate) {
+    auto Loaded = readProfile(opts::CMOVBranchifyProfile, *Hash);
+    if (!Loaded)
+      return Loaded.takeError();
+    Profile = std::move(*Loaded);
+  }
+  uint64_t Candidates = 0, Converted = 0, RejectedProfile = 0;
+  BinaryFunction *Kernel = nullptr, *ABIEntry = nullptr, *Plain = nullptr;
+  bool RuntimeABI = false;
+  if (opts::CMOVBranchifyRuntime) {
+    if (!BC.isELF() || !BC.HasRelocations || opts::Instrument || BC.getRuntimeLibrary())
+      return invalid("runtime mode needs ELF relocations and no instrumentation/hugify");
+    for (auto &Item : BC.getBinaryFunctions()) {
+      BinaryFunction &F = Item.second;
+      if (F.hasName("__bolt_cmov_branch_v1") || F.hasName("__bolt_cmov_adapt_v1") || F.hasName("__bolt_cmov_observe_v1") ||
+          F.hasName("__bolt_cmov_rt_thunk_v1"))
+        return invalid("input already contains reserved CMOV runtime symbols");
+      if (F.hasName(opts::CMOVRuntimeKernel)) Kernel = &F;
+      if (F.hasName(opts::CMOVRuntimeEntry)) ABIEntry = &F;
+      if (F.hasName(opts::CMOVRuntimePlain)) Plain = &F;
+    }
+    RuntimeABI = Kernel && ABIEntry && Plain && Kernel != ABIEntry && Kernel != Plain &&
+                 ABIEntry != Plain && ABIEntry->hasCFG() && ABIEntry->isSimple() &&
+                 !ABIEntry->hasEHRanges() && !ABIEntry->isMultiEntry() &&
+                 ABIEntry->size() == 1 && ABIEntry->getFDEProgram().empty();
+    unsigned Instructions = 0;
+    if (RuntimeABI)
+      for (const MCInst &Inst : ABIEntry->front()) {
+        if (BC.MIB->isPseudo(Inst)) continue;
+        ++Instructions;
+        RuntimeABI &= BC.MIB->isTailCall(Inst) &&
+                      BC.getFunctionForSymbol(BC.MIB->getTargetSymbol(Inst)) == Plain;
+      }
+    RuntimeABI &= Instructions == 1;
+    if (!RuntimeABI)
+      BC.outs() << "BOLT-INFO: CMOV runtime: unsupported or missing forwarding batch ABI; preserving code\n";
+  }
+  json::Array Manifest;
+  for (auto &Entry : BC.getBinaryFunctions()) {
+    BinaryFunction &BF = Entry.second;
+    if (opts::CMOVBranchifyRuntime && (!RuntimeABI || &BF != Kernel))
+      continue;
+    if (!shouldOptimize(BF) || !BF.hasCFG() || BF.isMultiEntry() ||
+        BF.hasJumpTables() || BF.hasEHRanges() || BF.hasSDTMarker())
+      continue;
+    BF.calculateLoopInfo();
+    SmallVector<Site, 8> Sites;
+    for (BinaryBasicBlock &BB : BF) {
+      if (BB.isLandingPad() || BB.hasLocSyms())
+        continue;
+      for (unsigned I = 0; I < BB.size();) {
+        MCInst First = BB.begin()[I];
+        unsigned CC;
+        if (BC.MIB->getInstLabel(First) ||
+            !BC.MIB->convertConditionalMoveToMove(First, CC)) {
+          ++I;
+          continue;
+        }
+        unsigned End = I, MovesBytes = 0;
+        while (End < BB.size()) {
+          MCInst Move = BB.begin()[End];
+          unsigned ThisCC;
+          if (BC.MIB->getInstLabel(Move) ||
+              !BC.MIB->convertConditionalMoveToMove(Move, ThisCC) ||
+              ThisCC != CC)
+            break;
+          MovesBytes += BC.computeInstructionSize(Move);
+          ++End;
+        }
+        const unsigned Count = End - I;
+        auto Offset = BC.MIB->getOffset(BB.begin()[I]);
+        auto EndOffset = End < BB.size()
+                             ? BC.MIB->getOffset(BB.begin()[End])
+                             : std::nullopt;
+        if (Count < 2 || Count > 4 || !Offset || !EndOffset ||
+            *EndOffset <= *Offset) {
+          I = End;
+          continue;
+        }
+        const BinaryLoop *Loop = BF.getLoopInfo().getLoopFor(&BB);
+        const unsigned Depth = Loop ? Loop->getLoopDepth() : 0;
+        Sites.push_back({&BB, I, Count, CC, *Offset, *EndOffset, Depth,
+                         *EndOffset - *Offset, MovesBytes + 2});
+        Manifest.push_back(json::Object{
+            {"function", BF.getOneName()}, {"offset", *Offset},
+            {"end_offset", *EndOffset}, {"true_offset", *Offset},
+            {"false_offset", *EndOffset}, {"group_size", Count},
+            {"condition", CC}, {"loop_depth", Depth},
+            {"old_bytes", *EndOffset - *Offset}, {"estimated_bytes", MovesBytes + 2}});
+        ++Candidates;
+        I = End;
+      }
+    }
+    bool Changed = false;
+    if (opts::CMOVBranchifyRuntime) {
+      const Site *S = Sites.size() == 1 ? &Sites.front() : nullptr;
+      auto Found = S ? Profile.find(key(BF.getOneName(), S->Offset)) : Profile.end();
+      const Predicate *P = Found == Profile.end() ? nullptr : &Found->second;
+      const uint64_t Total = P ? P->True + P->False : 0;
+      if (!S || !P || P->Size != S->Count || !S->LoopDepth ||
+          S->NewBytes > S->OldBytes || Total < opts::CMOVBranchifyMinCount ||
+          static_cast<__uint128_t>(std::max(P->True, P->False))*100 <
+              static_cast<__uint128_t>(Total)*opts::CMOVBranchifyMinBias ||
+          !P->Validated || P->ValidationLower < 1.02 || !canClone(BF)) {
+        ++RejectedProfile;
+        continue;
+      }
+      // An unrecognised early-exit prefix must not acquire an unbounded
+      // monitoring cost. Keep the original forwarding code in that case.
+      auto EntryCode = zeroWorkEntry(BF, Kernel->getSymbol(), Kernel->getSymbol());
+      if (EntryCode.Blocks.empty()) {
+        ++RejectedProfile;
+        BC.outs() << "BOLT-INFO: CMOV runtime: unproved zero-work prefix; preserving code\n";
+        continue;
+      }
+      DenseMap<const BinaryBasicBlock *, BinaryBasicBlock *> Map;
+      BinaryFunction *Clone = cloneKernel(BF, Map);
+      Site Copy = *S;
+      Copy.BB = Map[S->BB];
+      branchify(*Clone, Copy, P);
+      Clone->constructDomTree();
+      Clone->calculateLoopInfo();
+      assert(Clone->validateCFG() && "invalid cloned CMOV CFG");
+      BinaryFunction *Thunk = BC.createInjectedBinaryFunction("__bolt_cmov_rt_thunk_v1");
+      MCInst RuntimeJump;
+      BC.MIB->createTailCall(RuntimeJump,
+          BC.Ctx->getOrCreateSymbol("__bolt_cmov_adapt_v1"), BC.Ctx.get());
+      Thunk->addBasicBlock()->addInstruction(RuntimeJump);
+      // Keep the input's forwarding entry symbol; replace only its proven
+      // stack-neutral tail-jump body. Its callers and function pointers agree.
+      BinaryBasicBlock &Head = ABIEntry->front();
+      Head.clear();
+      Head.removeAllSuccessors();
+      EntryCode = zeroWorkEntry(BF, Clone->getSymbol(), Thunk->getSymbol());
+      assert(EntryCode.Blocks.size() == 9 && "zero-work proof changed");
+      // The proved empty-query scan and zero-return blocks are cold under the
+      // training profile; normal first-slice calls fall through to the guard.
+      auto Hot = [](unsigned I) { return I < 3 || I > 6; };
+      SmallVector<BinaryBasicBlock *, 8> EntryBlocks{&Head};
+      for (unsigned I = 1; I != EntryCode.Blocks.size(); ++I)
+        EntryBlocks.push_back(ABIEntry->addBasicBlock(EntryCode.Blocks[I].first));
+      for (unsigned I = 0; I != EntryCode.Blocks.size(); ++I) {
+        EntryBlocks[I]->setCFIState(Head.getCFIState());
+        EntryBlocks[I]->addInstructions(std::move(EntryCode.Blocks[I].second));
+        EntryBlocks[I]->setExecutionCount(Hot(I) ? Head.getExecutionCount() : 0);
+      }
+      for (auto [From, To] : EntryCode.Edges)
+        EntryBlocks[From]->addSuccessor(EntryBlocks[To], Hot(From) && Hot(To) ? Head.getExecutionCount() : 0, 0);
+      ABIEntry->constructDomTree();
+      ABIEntry->calculateLoopInfo();
+      assert(ABIEntry->validateCFG() && "invalid zero-work entry CFG");
+      BC.setRuntimeLibrary(std::make_unique<CMOVRuntimeLibrary>(Thunk));
+      ++Converted;
+      BC.outs() << "BOLT-INFO: CMOV runtime: retained original kernel, cloned branch kernel, rewrote batch ABI entry\n";
+      BC.outs() << "BOLT-INFO: CMOV runtime: proved zero-work prefix, lifted batch fast return\n";
+      continue;
+    }
+    // Later sites are split first so earlier instruction indices stay valid.
+    for (const Site &S : llvm::reverse(Sites)) {
+      const Predicate *P = nullptr;
+      if (opts::CMOVBranchify || opts::CMOVBranchifyCandidate) {
+        auto Found = Profile.find(key(BF.getOneName(), S.Offset));
+        if (Found != Profile.end())
+          P = &Found->second;
+        const uint64_t Total = P ? P->True + P->False : 0;
+        if (!P || P->Size != S.Count || !S.LoopDepth ||
+            S.NewBytes > S.OldBytes || Total < opts::CMOVBranchifyMinCount ||
+            static_cast<__uint128_t>(std::max(P->True, P->False)) * 100 <
+                static_cast<__uint128_t>(Total) * opts::CMOVBranchifyMinBias ||
+            (opts::CMOVBranchify && (!P->Validated || P->ValidationLower < 1.02))) {
+          ++RejectedProfile;
+          continue;
+        }
+      } else if (!opts::CMOVBranchifyProbe) {
+        continue;
+      }
+      branchify(BF, S, P);
+      ++Converted;
+      Changed = true;
+    }
+    if (Changed) {
+      BF.constructDomTree();
+      BF.calculateLoopInfo();
+      assert(BF.validateCFG() && "invalid CFG after CMOV branchification");
+    }
+  }
+  // Restore the normal postProcessCFG cleanup before later passes. Retaining
+  // temporary offsets on NOPs would prevent RemoveNops from deleting them,
+  // changing code/layout even when every candidate was rejected.
+  if (!opts::Instrument)
+    for (BinaryFunction *Function : BC.getAllBinaryFunctions()) {
+      BinaryFunction &BF = *Function;
+      if (BF.hasCFG() && !BF.requiresPreciseAddressMap())
+        for (BinaryBasicBlock &BB : BF)
+          for (MCInst &Inst : BB)
+            BC.MIB->clearOffset(Inst);
+    }
+  if (!opts::CMOVBranchifySites.empty()) {
+    std::error_code EC;
+    raw_fd_ostream OS(opts::CMOVBranchifySites, EC);
+    if (EC)
+      return invalid(Twine("cannot write manifest: ") + EC.message());
+    OS << json::Value(json::Object{{"schema_version", 1},
+                                   {"binary_sha256", *Hash},
+                                   {"host_cpu", sys::getHostCPUName()},
+                                   {"sites", std::move(Manifest)}})
+       << '\n';
+  }
+  BC.outs() << "BOLT-INFO: CMOV branchify: " << Candidates << " candidates, "
+            << Converted << " converted, " << RejectedProfile
+            << " rejected by admission\n";
+  return Error::success();
+}
