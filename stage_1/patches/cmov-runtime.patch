+++ b/bolt/test/X86/cmov-branchify.s
@@ -0,0 +1,105 @@
+# REQUIRES: system-linux
+# RUN: llvm-mc -filetype=obj -triple x86_64-unknown-unknown %s -o %t.o
+# RUN: %clang %cflags %t.o -o %t.exe -Wl,-q -nostdlib -no-pie
+# RUN: llvm-bolt %t.exe -o %t.enumerated --lite=0 --cmov-branchify-sites=%t.sites
+# RUN: llvm-bolt %t.exe -o %t.off --lite=0
+# RUN: %python %S/../Inputs/cmov-branchify-profile.py %t.sites %t.profile
+# RUN: llvm-bolt %t.exe -o %t.on --lite=0 --cmov-branchify --cmov-branchify-profile=%t.profile --verify-cfg | FileCheck %s --check-prefix=STATS
+# RUN: llvm-objdump -d --no-show-raw-insn --disassemble-symbols=subject %t.on | FileCheck %s --check-prefix=ON
+# RUN: llvm-objdump -d --no-show-raw-insn --disassemble-symbols=subject %t.off | FileCheck %s --check-prefix=OFF
+# RUN: llvm-bolt %t.exe -o %t.probe -instrument --instrumentation-sleep-time=1 --cmov-branchify-probe | FileCheck %s --check-prefix=STATS
+# RUN: %python %S/../Inputs/cmov-branchify-profile.py %t.sites %t.unvalidated unvalidated
+# RUN: llvm-bolt %t.exe -o %t.reject --lite=0 --cmov-branchify --cmov-branchify-profile=%t.unvalidated --verify-cfg | FileCheck %s --check-prefix=REJECT
+# RUN: llvm-objdump -d --no-show-raw-insn --disassemble-symbols=subject %t.reject | FileCheck %s --check-prefix=OFF
+# RUN: %python %S/../Inputs/cmov-branchify-profile.py %t.sites %t.unbiased unbiased
+# RUN: llvm-bolt %t.exe -o %t.reject2 --lite=0 --cmov-branchify --cmov-branchify-profile=%t.unbiased --verify-cfg | FileCheck %s --check-prefix=REJECT
+# RUN: %python %S/../Inputs/cmov-branchify-profile.py %t.sites %t.bad-hash wrong-hash
+# RUN: not llvm-bolt %t.exe -o %t.bad --cmov-branchify --cmov-branchify-profile=%t.bad-hash 2>&1 | FileCheck %s --check-prefix=HASH
+# RUN: %python %S/../Inputs/cmov-branchify-profile.py %t.sites %t.bad-cpu wrong-cpu
+# RUN: not llvm-bolt %t.exe -o %t.bad --cmov-branchify --cmov-branchify-profile=%t.bad-cpu 2>&1 | FileCheck %s --check-prefix=CPU
+# RUN: not llvm-bolt %t.exe -o %t.bad --cmov-branchify 2>&1 | FileCheck %s --check-prefix=MISSING
+# STATS: CMOV branchify: 1 candidates, 1 converted
+# REJECT: CMOV branchify: 1 candidates, 0 converted, 1 rejected
+# HASH: input SHA256 mismatch
+# CPU: profile CPU mismatch
+# MISSING: requires -cmov-branchify-profile
+# ON-LABEL: <subject>:
+# ON-NOT: cmov
+# ON: j{{b|ae}}
+# ON-NOT: cmov
+# ON: retq
+# OFF-LABEL: <subject>:
+# OFF-COUNT-2: cmovaeq
+
+.text
+.globl _start
+.type _start,@function
+_start:
+  call subject
+  mov $60, %eax
+  xor %edi, %edi
+  syscall
+.size _start, .-_start
+
+.globl subject
+.type subject,@function
+subject:
+.cfi_startproc
+  mov $8, %ecx
+.Lloop:
+  cmp %rsi, %rdi
+  cmovae %r8, %rax
+  cmovae %r9, %rdx
+  dec %ecx
+  jne .Lloop
+  ret
+.cfi_endproc
+.size subject, .-subject
+
+.globl reject32
+.type reject32,@function
+reject32:
+  cmp %rsi, %rdi
+  cmovae %r8d, %eax
+  cmovae %r9d, %edx
+  ret
+.size reject32, .-reject32
+
+.globl reject_memory
+.type reject_memory,@function
+reject_memory:
+  cmp %rsi, %rdi
+  cmovae (%r8), %rax
+  cmovae (%r9), %rdx
+  ret
+.size reject_memory, .-reject_memory
+
+.globl reject_stack
+.type reject_stack,@function
+reject_stack:
+  cmp %rsi, %rdi
+  cmovae %r8, %rsp
+  cmovae %r9, %rdx
+  ret
+.size reject_stack, .-reject_stack
+
+.globl reject_mixed
+.type reject_mixed,@function
+reject_mixed:
+  cmp %rsi, %rdi
+  cmovae %r8, %rax
+  cmovb %r9, %rdx
+  ret
+.size reject_mixed, .-reject_mixed
+
+.globl reject_entry
+.type reject_entry,@function
+reject_entry:
+  cmp %rsi, %rdi
+  jae .Lmiddle
+  cmovae %r8, %rax
+.Lmiddle:
+  cmovae %r9, %rdx
+  ret
+.size reject_entry, .-reject_entry
+.section .note.GNU-stack,"",@progbits
